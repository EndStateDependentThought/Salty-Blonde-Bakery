---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import PagePhotoHero from '../components/shared/PagePhotoHero.astro';
import OrderAction from '../components/site/OrderAction.astro';
import { images } from '../data/images';
import { businessConfig } from '../config/business';
---

<SiteLayout
  title="Cinnamon Rolls in Austin | Salty Blonde Bakery"
  description="Fresh cinnamon rolls in Austin, baked from scratch in small batches at Salty Blonde Bakery in Hyde Park. Classic rolls, rotating specials, pickup, delivery, and pre-orders."
>
  <main id="main-content">
    <PagePhotoHero
      eyebrow="Hyde Park · Austin"
      title="Cinnamon rolls in Austin,<br /><em>baked fresh in Hyde Park.</em>"
      body="Soft layers, gooey cinnamon centers, simple icing, and rotating specialty rolls that give regulars a reason to check back."
      imageId="menuClassicCinnamonRoll"
      supportImageId="rollTear"
      ctaLabel="See today’s menu"
      ctaHref="/order/"
      secondaryLabel="Visit the bakery"
      secondaryHref="/visit/"
    />

    <section class="story-section">
      <div class="story-section__inner shell shell--wide">
        <div class="story-section__copy reveal">
          <p class="handwritten-ish">What people come looking for</p>
          <h2>Soft centers, golden edges, and a proper amount of icing.</h2>
          <p>If you found Salty Blonde while searching for the best cinnamon rolls in Austin, the reviews tend to point to the same details: soft dough, fresh batches, balanced sweetness, and specialty flavors that still taste like a cinnamon roll first.</p>
          <p>Our Classic Cinnamon Roll stays simple on purpose. Around it, the menu rotates through fruit, caramel, pecan, coffee-cake, and seasonal ideas in small batches.</p>
          <a class="text-link" href="/menu/#classic-cinnamon-roll">See the Classic Cinnamon Roll <span aria-hidden="true">→</span></a>
        </div>
        <figure class="story-section__image reveal reveal--delay-1" style={`--image-position:${images.heroRoll.focalPoint}`}>
          <Image src={images.heroRoll.src} alt={images.heroRoll.alt} widths={[520, 760, 1000, 1280]} sizes="(max-width: 720px) 100vw, 45vw" quality="high" loading="lazy" decoding="async" />
        </figure>
      </div>
    </section>

    <section class="values-section" aria-labelledby="rolls-values-title">
      <div class="values-section__inner shell shell--wide">
        <div class="values-section__intro reveal">
          <p class="handwritten-ish">The useful details</p>
          <h2 id="rolls-values-title">Fresh today, easy to find, worth planning ahead for.</h2>
        </div>
        <div class="values-grid">
          <article class="reveal"><h3>Baked in small batches</h3><p>Fresh on the days we are open, with current availability changing as batches sell through.</p></article>
          <article class="reveal reveal--delay-1"><h3>Classic + rotating</h3><p>The Classic anchors the menu while specialty rolls change with the week and season.</p></article>
          <article class="reveal reveal--delay-2"><h3>Pickup, delivery, pre-order</h3><p>Visit Hyde Park, check the live delivery menus, or request larger orders with at least {businessConfig.preorders.minimumNotice} notice.</p></article>
        </div>
      </div>
    </section>

    <section class="preorder-section">
      <div class="preorder-section__inner shell shell--wide">
        <figure class="preorder-section__image reveal" style={`--image-position:${images.processRolls.focalPoint}`}>
          <Image src={images.processRolls.src} alt={images.processRolls.alt} widths={[640, 900, 1200]} sizes="(max-width: 720px) 100vw, 46vw" quality="high" loading="lazy" decoding="async" />
        </figure>
        <div class="preorder-section__copy reveal reveal--delay-1">
          <p class="handwritten-ish">Planning brunch, a meeting, or a very good weekend?</p>
          <h2>Cinnamon-roll packs can be requested ahead.</h2>
          <p>For larger orders, send a pre-order request and the bakery will confirm availability, pickup timing, and total.</p>
          <div class="inline-actions">
            <a class="order-action" href="/preorder/"><span>Start a pre-order request</span><span aria-hidden="true">→</span></a>
            <OrderAction label="Order today instead" variant="soft" />
          </div>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
