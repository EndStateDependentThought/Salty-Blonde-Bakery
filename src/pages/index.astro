---
import SiteLayout from '../layouts/SiteLayout.astro';
import AppetiteHero from '../components/home/AppetiteHero.astro';
import BakeWall from '../components/home/BakeWall.astro';
import SeasonalFeature from '../components/shared/SeasonalFeature.astro';
import LiveMenuHandoff from '../components/home/LiveMenuHandoff.astro';
import ProcessStory from '../components/home/ProcessStory.astro';
import ReviewProof from '../components/home/ReviewProof.astro';
import VisitPreview from '../components/home/VisitPreview.astro';
import ClosingOrderMoment from '../components/home/ClosingOrderMoment.astro';
---

<SiteLayout
  title="Austin Bakery for Cinnamon Rolls & Cookies | Salty Blonde Bakery"
  description="Salty Blonde is a small-batch bakery in Hyde Park, Austin serving fresh cinnamon rolls, brown butter cookies, seasonal desserts, pickup, delivery, and pre-orders."
>
  <main id="main-content">
    <AppetiteHero />
    <SeasonalFeature />
    <BakeWall />
    <LiveMenuHandoff />
    <ProcessStory />
    <ReviewProof />
    <VisitPreview />
    <ClosingOrderMoment />
  </main>
</SiteLayout>
