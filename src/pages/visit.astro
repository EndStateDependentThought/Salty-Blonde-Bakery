---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import PagePhotoHero from '../components/shared/PagePhotoHero.astro';
import OrderAction from '../components/site/OrderAction.astro';
import { images } from '../data/images';
import { businessConfig } from '../config/business';

---

<SiteLayout
  title="Visit | Salty Blonde Bakery in Hyde Park Austin"
  description="Visit Salty Blonde Bakery at 4215 Ave H in Hyde Park, Austin. See current hours, directions, contact details, and ordering options."
>
  <main id="main-content">
    <PagePhotoHero
      eyebrow="Hyde Park · Austin"
      title="The trailer is small.<br /><em>The rolls are not.</em>"
      body="Find Salty Blonde at 4215 Ave H in the parking lot across from Fresh Plus. Come by for the bakery in person, or check the live menu before you head over."
      imageId="trailer"
      supportImageId="glazedRollHand"
      ctaLabel="Get directions"
      ctaHref={businessConfig.directionsUrl}
      secondaryLabel="See today’s menu"
      secondaryHref="/order/"
    />

    <section class="visit-details" aria-labelledby="visit-details-title">
      <div class="visit-details__inner shell shell--wide">
        <div class="visit-details__address reveal">
          <p class="handwritten-ish">Come by</p>
          <h2 id="visit-details-title">{businessConfig.address.street}<br />{businessConfig.address.city}, {businessConfig.address.region} {businessConfig.address.postalCode}</h2>
          <p>{businessConfig.address.note}</p>
          <a class="order-action" href={businessConfig.directionsUrl} target="_blank" rel="noreferrer"><span>Get directions</span><span aria-hidden="true">↗</span></a>
        </div>

        <div class="visit-details__hours reveal reveal--delay-1">
          <h3>Hours</h3>
          <dl class="hours-list">
            {businessConfig.hours.map((row) => (
              <div><dt>{row.label}</dt><dd>{row.display}</dd></div>
            ))}
          </dl>
          <p class="small-note">Small batches and rotating specials can sell through. For the current delivery lineup, check the live ordering menus.</p>
          <OrderAction label="See today’s menu" variant="soft" />
        </div>
      </div>
    </section>

    <section class="visit-photo-band">
      <div class="visit-photo-band__grid shell shell--wide">
        <figure class="reveal" style={`--image-position:${images.heroRoll.focalPoint}`}>
          <Image src={images.heroRoll.src} alt={images.heroRoll.alt} widths={[480, 720, 960]} sizes="(max-width: 720px) 58vw, 27vw" quality="high" loading="lazy" decoding="async" />
        </figure>
        <figure class="reveal reveal--delay-1" style={`--image-position:${images.packaging.focalPoint}`}>
          <Image src={images.packaging.src} alt={images.packaging.alt} widths={[640, 900, 1200]} sizes="(max-width: 720px) 100vw, 45vw" quality="high" loading="lazy" decoding="async" />
        </figure>
        <figure class="reveal reveal--delay-2" style={`--image-position:${images.glazedRollHand.focalPoint}`}>
          <Image src={images.glazedRollHand.src} alt={images.glazedRollHand.alt} widths={[480, 720, 960]} sizes="(max-width: 720px) 58vw, 27vw" quality="high" loading="lazy" decoding="async" />
        </figure>
      </div>
    </section>

    <section class="contact-section">
      <div class="contact-section__inner shell shell--wide">
        <div class="reveal">
          <p class="handwritten-ish">Need to ask us something?</p>
          <h2>Talk to the bakery.</h2>
        </div>
        <div class="contact-section__links reveal reveal--delay-1">
          <a href={`mailto:${businessConfig.email}`}><span>Email</span><strong>{businessConfig.email}</strong></a>
          <a href={`tel:${businessConfig.phoneHref}`}><span>Phone</span><strong>{businessConfig.phoneDisplay}</strong></a>
          <a href={businessConfig.instagramUrl} target="_blank" rel="noreferrer"><span>Instagram</span><strong>@the.saltyblondebakery ↗</strong></a>
        </div>
        <div class="contact-section__preorder reveal reveal--delay-2">
          <h3>Planning ahead?</h3>
          <p>Larger pre-orders can be requested with at least {businessConfig.preorders.minimumNotice} notice. We’ll follow up to confirm availability, timing, and total.</p>
          <a class="text-link" href="/preorder/">Start a pre-order request <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
