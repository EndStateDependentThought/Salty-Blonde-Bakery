---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import PagePhotoHero from '../components/shared/PagePhotoHero.astro';
import LiveMenuLinks from '../components/shared/LiveMenuLinks.astro';
import OrderAction from '../components/site/OrderAction.astro';
import { images } from '../data/images';
import { menuItems } from '../data/menu';
import { businessConfig } from '../config/business';

const originals = menuItems.filter((item) => item.categoryId === 'rolls' || item.categoryId === 'cookies');
const rotatingImages = [images.fruitGlazeRoll, images.sprinkleRoll, images.redCookie, images.amberRoll, images.crumbCookieTear, images.pecanSlab];
---

<SiteLayout
  title="Menu | Cinnamon Rolls & Cookies in Austin | Salty Blonde Bakery"
  description="Browse Salty Blonde Bakery cinnamon rolls, brown butter cookies, rotating specialty flavors, sampler packs, and pre-orders in Hyde Park, Austin."
>
  <main id="main-content">
    <PagePhotoHero
      eyebrow="What we bake"
      title="The staples stay.<br /><em>The fun part rotates.</em>"
      body="Salty Blonde is built around soft cinnamon rolls, brown butter cookies, and a changing lineup of seasonal specials. Today’s exact availability lives on the ordering menus."
      imageId="rollTear"
      supportImageId="crumbCookieTear"
      ctaLabel="See today’s menu"
      ctaHref="/order/"
      secondaryLabel="Browse the classics"
      secondaryHref="#classics"
    />

    <section class="menu-live-callout">
      <div class="menu-live-callout__inner shell shell--wide reveal">
        <div>
          <p class="handwritten-ish">Today is allowed to be different</p>
          <h2>For what’s actually in the case right now, go live.</h2>
          <p>We rotate specials and small batches often. The delivery menus are the current source for availability and ordering.</p>
        </div>
        <LiveMenuLinks compact={true} />
      </div>
    </section>

    <section class="classics-section" id="classics" aria-labelledby="classics-title">
      <div class="classics-section__heading shell shell--wide reveal">
        <p class="handwritten-ish">The originals</p>
        <h2 id="classics-title">The things people come back looking for.</h2>
      </div>

      <div class="classics-list shell shell--wide">
        {originals.map((item, index) => {
          const image = item.imageId ? images[item.imageId as keyof typeof images] : images.heroRoll;
          return (
            <article class:list={['classic-feature', index % 2 === 1 && 'classic-feature--reverse']} id={item.slug}>
              <figure class="classic-feature__image reveal" style={`--image-position:${image.focalPoint}`}>
                <Image src={image.src} alt={image.alt} widths={[520, 760, 1000, 1280]} sizes="(max-width: 720px) 100vw, 48vw" quality="high" loading="lazy" decoding="async" />
              </figure>
              <div class="classic-feature__copy reveal reveal--delay-1">
                <h3>{item.name}</h3>
                <p>{item.description}</p>
                {item.allergens && <p class="allergen-note">{item.allergens}</p>}
                <a class="text-link" href="/order/">Check today’s menu <span aria-hidden="true">→</span></a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="rotation-section" aria-labelledby="rotation-title">
      <div class="rotation-section__intro shell shell--wide reveal">
        <div>
          <p class="handwritten-ish">Rotating specials</p>
          <h2 id="rotation-title">A year of reasons to check back.</h2>
        </div>
        <p>These are past and rotating Salty Blonde bakes, not a promise that every flavor is available today. That’s the point: the lineup keeps moving.</p>
      </div>

      <div class="rotation-grid shell shell--wide">
        {rotatingImages.map((image, index) => (
          <figure class:list={['rotation-grid__item', `rotation-grid__item--${index + 1}`, 'reveal']} style={`--image-position:${image.focalPoint}`}>
            <Image src={image.src} alt={image.alt} widths={[420, 640, 900, 1200]} sizes="(max-width: 720px) 50vw, 29vw" quality="high" loading="lazy" decoding="async" />
          </figure>
        ))}
      </div>
    </section>

    <section class="preorder-section" id="preorders">
      <div class="preorder-section__inner shell shell--wide">
        <figure class="preorder-section__image reveal" style={`--image-position:${images.packaging.focalPoint}`}>
          <Image src={images.packaging.src} alt={images.packaging.alt} widths={[640, 900, 1200]} sizes="(max-width: 720px) 100vw, 46vw" quality="high" loading="lazy" decoding="async" />
        </figure>
        <div class="preorder-section__copy reveal reveal--delay-1">
          <p class="handwritten-ish">Need more than one box?</p>
          <h2>Packs, office mornings, parties, bigger bakery orders.</h2>
          <p>Cookie dozens, cinnamon-roll packs, specialty items, and larger bakery orders can be requested with at least {businessConfig.preorders.minimumNotice} notice. A request is not confirmed until the bakery follows up.</p>
          <div class="inline-actions">
            <a class="order-action" href="/preorder/"><span>Start a pre-order request</span><span aria-hidden="true">→</span></a>
            <OrderAction label="Order today instead" variant="soft" />
          </div>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
