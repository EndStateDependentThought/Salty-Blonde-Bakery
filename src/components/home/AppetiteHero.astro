---
import { Image } from 'astro:assets';
import { images } from '../../data/images';
import OrderAction from '../site/OrderAction.astro';
---

<section class="appetite-hero" aria-labelledby="hero-title" data-hero>
  <div class="appetite-hero__inner shell shell--wide">
    <div class="appetite-hero__copy reveal">
      <p class="hero-location">Hyde Park · Austin</p>
      <h1 id="hero-title">Big rolls. Brown butter cookies. <em>Something new every week.</em></h1>
      <p class="hero-lede">Small-batch bakery, baked from scratch and built around handmade cinnamon rolls, cookies, and rotating specials.</p>
      <div class="hero-actions">
        <OrderAction label="Order what’s baking today" />
        <a class="text-link" href="#bakes">See what we’ve baked <span aria-hidden="true">↓</span></a>
      </div>
    </div>

    <div class="hero-collage" aria-label="Salty Blonde bakery highlights">
      <figure class="hero-collage__sprinkles reveal reveal--delay-1" style={`--image-position:${images.sprinklePair.focalPoint}`}>
        <Image src={images.sprinklePair.src} alt={images.sprinklePair.alt} widths={[480, 720, 960]} sizes="(max-width: 720px) 48vw, 29vw" quality="high" loading="eager" decoding="async" />
      </figure>
      <figure class="hero-collage__lead reveal" style={`--image-position:${images.heroRoll.focalPoint}`}>
        <span class="hero-collage__lavender" aria-hidden="true"></span>
        <Image src={images.heroRoll.src} alt={images.heroRoll.alt} widths={[640, 900, 1200, 1500]} sizes="(max-width: 720px) 72vw, 36vw" quality="high" loading="eager" decoding="async" fetchpriority="high" />
      </figure>
      <figure class="hero-collage__cookie reveal reveal--delay-2" style={`--image-position:${images.cookieCrossSection.focalPoint}`}>
        <Image src={images.cookieCrossSection.src} alt={images.cookieCrossSection.alt} widths={[360, 520, 720]} sizes="(max-width: 720px) 38vw, 18vw" quality="high" loading="eager" decoding="async" />
      </figure>
      <figure class="hero-collage__fruit reveal reveal--delay-2" style={`--image-position:${images.fruitGlazeRoll.focalPoint}`}>
        <Image src={images.fruitGlazeRoll.src} alt={images.fruitGlazeRoll.alt} widths={[360, 520, 720]} sizes="(max-width: 720px) 40vw, 17vw" quality="high" loading="lazy" decoding="async" />
      </figure>
    </div>
  </div>
</section>
