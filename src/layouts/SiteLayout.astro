---
import '@fontsource-variable/playfair-display/wght.css';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '@fontsource-variable/karla/wght.css';
import '../styles/global.css';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import { businessConfig } from '../config/business';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og-salty-blonde.jpg',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, businessConfig.siteUrl).toString();
const imageUrl = new URL(image, businessConfig.siteUrl).toString();
const openingHoursSpecification = businessConfig.hours
  .filter((row) => row.opens && row.closes)
  .map((row) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: row.schemaDays,
    opens: row.opens,
    closes: row.closes,
  }));

const bakerySchema = {
  '@context': 'https://schema.org',
  '@type': 'Bakery',
  name: businessConfig.name,
  url: businessConfig.siteUrl,
  image: imageUrl,
  description: businessConfig.description,
  telephone: businessConfig.phoneHref,
  email: businessConfig.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: businessConfig.address.street,
    addressLocality: businessConfig.address.city,
    addressRegion: businessConfig.address.region,
    postalCode: businessConfig.address.postalCode,
    addressCountry: businessConfig.address.country,
  },
  openingHoursSpecification,
  sameAs: [businessConfig.instagramUrl],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbf4ec" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={businessConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(bakerySchema)}></script>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <script is:inline>
      (() => {
        const items = [...document.querySelectorAll('.reveal')];
        if (!items.length || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          items.forEach((item) => item.classList.add('is-visible'));
          return;
        }
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        }, { rootMargin: '0px 0px -4% 0px', threshold: 0.08 });
        items.forEach((item) => observer.observe(item));
      })();
    </script>
  </body>
</html>
